#!/usr/bin/env python3
"""cb — chrome-bridge CLI + relay daemon.

Stdlib only. Two roles:

  cb daemon              start the localhost relay (default port 9224)
  cb <verb> [...args]    queue a job, wait for the SW to consume + execute, print result

Verbs (all return JSON on stdout, exit 0 on ok=true, 1 otherwise):

  cb ping
  cb cookies <url> [--name N]
  cb gql <url> --query <file|-> [--vars JSON] [--bearer TOKEN] [--alias NAME]
  cb cookies-bearer <url> <cookie-name>     # convenience: read cookie value, used as bearer for next gql
  cb tabs [--query JSON]
  cb tab-update <tabId> --url URL [--active true]
  cb eval <tabId> <code|-> [--world MAIN|ISOLATED]
  cb capture-install <tabId> [--pattern STR_OR_re:REGEX]
  cb capture-drain <tabId>
  cb debug-click <tabId> <x> <y>
  cb debug-type <tabId> <text>

The relay also serves /poll (long-poll, SW polls here) and /result/<id> (SW posts results).
"""

from __future__ import annotations

import argparse
import http.server
import json
import os
import queue
import re
import socketserver
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path
from typing import Any

DEFAULT_PORT = 9224
RELAY = os.environ.get("CB_RELAY", f"http://127.0.0.1:{DEFAULT_PORT}")
PIDFILE = Path.home() / ".local/state/chrome-bridge/relay.pid"
LOGFILE = Path.home() / ".local/state/chrome-bridge/relay.log"

# === Daemon ==================================================================

JOBS: "queue.Queue[dict]" = queue.Queue()
RESULTS: dict[str, Any] = {}
RESULTS_LOCK = threading.Lock()
RESULTS_CV = threading.Condition(RESULTS_LOCK)


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):  # quieter
        sys.stderr.write("[cb-relay] " + fmt % args + "\n")

    def _json(self, code, payload):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _empty(self, code):
        self.send_response(code)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):
        if self.path.startswith("/poll"):
            wait = 20
            m = re.search(r"wait=(\d+)", self.path)
            if m:
                wait = min(int(m.group(1)), 25)
            try:
                job = JOBS.get(timeout=wait)
            except queue.Empty:
                return self._empty(204)
            return self._json(200, job)
        m = re.match(r"^/await/([a-f0-9]+)(?:\?wait=(\d+))?$", self.path)
        if m:
            jid = m.group(1)
            wait = min(int(m.group(2) or "5"), 25)
            deadline = time.time() + wait
            with RESULTS_CV:
                while jid not in RESULTS and time.time() < deadline:
                    RESULTS_CV.wait(timeout=max(0.1, deadline - time.time()))
                if jid in RESULTS:
                    return self._json(200, RESULTS.pop(jid))
            return self._empty(204)
        if self.path == "/health":
            return self._json(200, {"ok": True, "ts": time.time()})
        return self._empty(404)

    def do_POST(self):
        ln = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(ln) if ln else b""
        if self.path == "/job":
            job = json.loads(raw or b"{}")
            if "id" not in job:
                job["id"] = uuid.uuid4().hex
            JOBS.put(job)
            return self._json(200, {"ok": True, "id": job["id"]})
        m = re.match(r"^/result/([a-f0-9]+)$", self.path)
        if m:
            jid = m.group(1)
            payload = json.loads(raw or b"{}")
            with RESULTS_CV:
                RESULTS[jid] = payload
                RESULTS_CV.notify_all()
            return self._json(200, {"ok": True})
        return self._empty(404)


class Threaded(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def daemon_main(port: int):
    PIDFILE.parent.mkdir(parents=True, exist_ok=True)
    PIDFILE.write_text(str(os.getpid()))
    srv = Threaded(("127.0.0.1", port), Handler)
    sys.stderr.write(f"[cb-relay] listening on 127.0.0.1:{port}\n")
    try:
        srv.serve_forever()
    finally:
        try: PIDFILE.unlink()
        except Exception: pass


# === Client ==================================================================

def post_job(kind: str, args: dict, timeout: float = 30.0) -> dict:
    jid = uuid.uuid4().hex
    body = json.dumps({"id": jid, "kind": kind, "args": args}).encode()
    req = urllib.request.Request(
        f"{RELAY}/job",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=5).read()
    except urllib.error.URLError as e:
        return {"ok": False, "error": f"relay-unreachable: {e}"}

    deadline = time.time() + timeout
    while time.time() < deadline:
        # poll the relay's results dict via a /result/<id> GET? Not implemented;
        # client and relay share process when single-process. We use a sidecar:
        # the daemon stores results in RESULTS dict in-process; the CLI client
        # is a separate process, so we long-poll a different endpoint.
        # → implement /await/<id> server-side
        try:
            r = urllib.request.urlopen(f"{RELAY}/await/{jid}?wait=5", timeout=10)
            return json.loads(r.read())
        except urllib.error.HTTPError as e:
            if e.code == 204:
                continue
            return {"ok": False, "error": f"http {e.code}: {e.read().decode(errors='ignore')}"}
        except urllib.error.URLError as e:
            return {"ok": False, "error": f"relay-unreachable: {e}"}
        time.sleep(0.5)
    return {"ok": False, "error": "timeout"}


def emit(payload: dict) -> int:
    print(json.dumps(payload, indent=2, ensure_ascii=False))
    return 0 if payload.get("ok") else 1


def read_maybe_stdin(arg: str) -> str:
    if arg == "-":
        return sys.stdin.read()
    p = Path(arg)
    if p.exists() and p.is_file():
        return p.read_text()
    return arg


def parse_json(s: str | None, default=None):
    if s is None:
        return default
    return json.loads(s)


def main():
    p = argparse.ArgumentParser(prog="cb")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("daemon").add_argument("--port", type=int, default=DEFAULT_PORT)

    sub.add_parser("ping")

    cookies = sub.add_parser("cookies")
    cookies.add_argument("url")
    cookies.add_argument("--name")

    gql = sub.add_parser("gql")
    gql.add_argument("url")
    gql.add_argument("--query", required=True)
    gql.add_argument("--vars", default="{}")
    gql.add_argument("--bearer")
    gql.add_argument("--bearer-cookie", help="cookie name on <url> to extract as Bearer token")
    gql.add_argument("--alias")

    cb = sub.add_parser("cookies-bearer")
    cb.add_argument("url")
    cb.add_argument("name")

    tabs = sub.add_parser("tabs")
    tabs.add_argument("--query", default="{}")

    tu = sub.add_parser("tab-update")
    tu.add_argument("tabId", type=int)
    tu.add_argument("--url")
    tu.add_argument("--active", default="false")

    ev = sub.add_parser("eval")
    ev.add_argument("tabId", type=int)
    ev.add_argument("code")
    ev.add_argument("--world", default="MAIN")

    ci = sub.add_parser("capture-install")
    ci.add_argument("tabId", type=int)
    ci.add_argument("--pattern", default="")

    cd = sub.add_parser("capture-drain")
    cd.add_argument("tabId", type=int)

    dc = sub.add_parser("debug-click")
    dc.add_argument("tabId", type=int)
    dc.add_argument("x", type=float)
    dc.add_argument("y", type=float)

    dt = sub.add_parser("debug-type")
    dt.add_argument("tabId", type=int)
    dt.add_argument("text")

    a = p.parse_args()

    if a.cmd == "daemon":
        return daemon_main(a.port)
    if a.cmd == "ping":
        return emit(post_job("ping", {}))
    if a.cmd == "cookies":
        args = {"url": a.url}
        if a.name:
            args["name"] = a.name
        return emit(post_job("cookies", args))
    if a.cmd == "cookies-bearer":
        r = post_job("cookies", {"url": a.url, "name": a.name})
        if not r.get("ok"):
            return emit(r)
        cs = r.get("cookies") or []
        v = (cs[0] or {}).get("value") if cs else None
        if not v:
            return emit({"ok": False, "error": "cookie-not-found", "name": a.name, "url": a.url})
        print(v)
        return 0
    if a.cmd == "gql":
        bearer = a.bearer
        if a.bearer_cookie and not bearer:
            r = post_job("cookies", {"url": a.url, "name": a.bearer_cookie})
            if not r.get("ok"):
                return emit(r)
            cs = r.get("cookies") or []
            bearer = (cs[0] or {}).get("value") if cs else None
            if not bearer:
                return emit({"ok": False, "error": "bearer-cookie-not-found", "name": a.bearer_cookie})
        args = {
            "url": a.url,
            "query": read_maybe_stdin(a.query),
            "variables": parse_json(a.vars, {}),
            "bearer": bearer,
            "alias": a.alias,
        }
        return emit(post_job("gql", args, timeout=60))
    if a.cmd == "tabs":
        return emit(post_job("tabs.query", {"query": parse_json(a.query, {})}))
    if a.cmd == "tab-update":
        active = a.active.lower() in ("1", "true", "yes")
        return emit(post_job("tabs.update", {"tabId": a.tabId, "url": a.url, "active": active}))
    if a.cmd == "eval":
        return emit(post_job("scripting.eval", {"tabId": a.tabId, "code": read_maybe_stdin(a.code), "world": a.world}))
    if a.cmd == "capture-install":
        return emit(post_job("capture.install", {"tabId": a.tabId, "pattern": a.pattern}))
    if a.cmd == "capture-drain":
        return emit(post_job("capture.drain", {"tabId": a.tabId}))
    if a.cmd == "debug-click":
        return emit(post_job("debugger.click", {"tabId": a.tabId, "x": a.x, "y": a.y}))
    if a.cmd == "debug-type":
        return emit(post_job("debugger.type", {"tabId": a.tabId, "text": a.text}))

    p.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main() or 0)
